{%- doc -%}
  Shared price styles used by product price, unit price, cart item pricing, quick order list pricing,
  and quick add's dynamically injected product content.

  Render this snippet from any file that directly emits price classes such as
  `.price`, `.compare-at-price`, `.unit-price`, `.tax-note`, `.volume-pricing-note`,
  `.price-discount-badge`, or `.price-item__group`, unless that file renders the
  `price` or `unit-price` snippet.

  @example
  {% render 'price-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .price,
  .compare-at-price,
  .unit-price {
    white-space: nowrap;
  }

  .unit-price {
    display: block;
    font-size: min(0.85em, var(--font-paragraph--size));
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .tax-note.tax-note.tax-note {
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .tax-note:empty {
    display: none;
  }

  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > *:not(.tax-note) {
    margin-block: 0;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .compare-at-price {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-30));
  }

  .price-item__group {
    display: inline-block;
  }

  /* Discount badge in the price row ("-31% off"), emitted by snippets/price.liquid
     beside the compare-at price.

     Colour is deliberately absent: the badge also carries
     `.color-custom-badge-sale`, the same class the card sale badge uses, so both
     track the Badges colour settings from one place and there is no cascade race
     between that class and this rule. Shape and type come through the `--badge-*`
     custom properties price.liquid sets inline from those same settings.

     Font size is capped the way .unit-price caps its own: relative to the price
     it sits beside, so it shrinks on a card, but never larger than body copy when
     the price block is set to a heading preset.

     vertical-align keeps it on the price's baseline box rather than letting an
     inline-flex child sit low, and the badge stays inline so the row keeps the
     block's own alignment - start on this store - instead of becoming a flex row
     that would need its own justification. */
  .price-discount-badge {
    display: inline-flex;
    align-items: center;
    margin-inline-start: var(--margin-2xs);
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);

    /* 999px, not var(--border-radius): that property is contextual in this theme
       (cards, images and cart thumbnails each set their own), so falling back to
       it would hand the badge whatever radius its surrounding card happens to
       carry. price.liquid always supplies --badge-border-radius; this is only the
       shape to land on if the badge is ever emitted without it. */
    border-radius: var(--badge-border-radius, 999px);
    font-family: var(--badge-font-family, var(--font-body--family));
    font-size: min(0.75em, var(--font-paragraph--size));
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    text-decoration-line: none;
    text-transform: var(--badge-text-transform, none);
    white-space: nowrap;
    vertical-align: middle;
  }
{% endstylesheet %}
